{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Search your storage without opening every chest. Indexes containers across your world, including unloaded chunks.",
  "authors": [ "adrian" ],
  "license": "MIT",
  "contact": {
    "homepage": "https://modrinth.com/mod/chestindex",
    "issues": "https://github.com/Ad1xn/Chest-Index/issues",
    "sources": "https://github.com/Ad1xn/Chest-Index"
  },
  "icon": "assets/chestindex/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [ "dev.adrian.chestindex.ChestIndex" ],
    "client": [ "dev.adrian.chestindex.client.ChestIndexClient" ],
    "server": [ "dev.adrian.chestindex.server.ChestIndexServer" ],
    "modmenu": [ "dev.adrian.chestindex.client.ModMenuIntegration" ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    { "config": "${mod_id}.client.mixins.json", "environment": "client" }
  ],
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=${loader_dep}",
    "minecraft": "${mc_dep}",
    "java": ">=${java_dep}",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "parent": {
        "id": "ad1xn",
        "name": "Ad1xn Mods",
        "description": "Mods by Ad1xn.",
        "icon": "assets/ad1xn/icon.png"
      }
    }
  }
}
