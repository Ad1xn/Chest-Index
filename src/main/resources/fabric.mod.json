{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Indexes every container in the world within a configurable radius - including chunks that are not loaded - so you can search your storage without opening a single chest. Works in singleplayer, on modded servers, and degrades gracefully on vanilla servers.",
  "authors": [ "adrian" ],
  "license": "MIT",
  "contact": {
    "homepage": "https://modrinth.com/mod/chestindex",
    "issues": "https://github.com/Ad1xn/Chest-Index/issues",
    "sources": "https://github.com/Ad1xn/Chest-Index"
  },
  "icon": "assets/chestindex/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [ "dev.adrian.chestindex.ChestIndex" ],
    "client": [ "dev.adrian.chestindex.client.ChestIndexClient" ],
    "server": [ "dev.adrian.chestindex.server.ChestIndexServer" ],
    "modmenu": [ "dev.adrian.chestindex.client.ModMenuIntegration" ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    { "config": "${mod_id}.client.mixins.json", "environment": "client" }
  ],
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=${loader_dep}",
    "minecraft": "${mc_dep}",
    "java": ">=${java_dep}",
    "fabric-api": "*"
  }
}
